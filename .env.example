FIREBASE_PROJECT_ID=flutterchilli
FIREBASE_STORAGE_BUCKET=flutterchilli.firebasestorage.app
# Set exactly one credential source: a secure path, JSON string, or ADC.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
MODEL_PATH=models/chilli_leaf_disease_final.tflite
LABELS_PATH=models/class_names.json
# This must be a separately trained chilli-versus-other-plant model.
IMAGE_VALIDATION_MODEL_PATH=models/leaf_detection.tflite
IMAGE_VALIDATION_REQUIRED=true
# Index of the chilli/plant-positive output in a 2+ class validator model.
IMAGE_VALIDATION_POSITIVE_CLASS_INDEX=1
IMAGE_VALIDATION_THRESHOLD=0.70
# For a 1-output sigmoid model where 0 = chilli leaf and 1 = non-chilli, set true.
IMAGE_VALIDATION_INVERT_SCORE=false
# Input scaling expected by the validator model: 0_1 ([0,1]), raw_255 ([0,255]), or neg1_1 ([-1,1]).
IMAGE_VALIDATION_INPUT_SCALE=0_1
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_SCANS_PER_MINUTE=10
MODEL_VERSION=chilli-leaf-disease-v1
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
